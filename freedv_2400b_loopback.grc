    gui_hint: ''
    label: Squelch FreeDV
    'true': 'True'
    type: bool
    value: 'True'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [704, 16]
    rotation: 0
    state: enabled
- name: squelch_thresh
  id: variable_qtgui_range
  parameters:
    comment: ''
    gui_hint: ''
    label: Umbral de squelch (dB)
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '-5.0'
    step: '0.5'
    stop: '20.0'
    value: '2.0'
