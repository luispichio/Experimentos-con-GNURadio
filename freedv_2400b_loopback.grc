    rangeType: float
    start: '0.0'
    step: '0.002'
    stop: '0.20'
    value: '0.0'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [528, 16]
    rotation: 0
    state: enabled
- name: squelch_enable
  id: variable_qtgui_check_box
  parameters:
    comment: ''
